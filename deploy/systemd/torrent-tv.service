[Unit]
Description=Torrent TV
After=network-online.target qbittorrent-nox.service
Wants=network-online.target

[Service]
Type=simple
User=torrent-tv
Group=torrent-tv
SupplementaryGroups=qbittorrent
WorkingDirectory=/var/lib/torrent-tv
ExecStart=/var/lib/torrent-tv/bin/torrent-tv serve --data-dir /var/lib/torrent-tv/data
Restart=always
RestartSec=10
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# pi-deploy.sh substitutes @DOWNLOAD_ROOT@ with the configured download root:
# the native engine writes media and session state there, so the sandbox must
# allow it. The leading dash tolerates a not-yet-created path. Never list the
# download root (or any writable path) below: systemd applies these lines in
# order, and a later mention re-mutes an earlier grant. The application
# binary lives in /var/lib/torrent-tv/bin, owned by the service
# user, so the in-application updater stages and swaps it inside the
# ReadWritePaths grant above without a privilege escalation.
ReadWritePaths=/var/lib/torrent-tv -@DOWNLOAD_ROOT@
ReadOnlyPaths=-/var/lib/qbittorrent/qBittorrent/downloads
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=250%
TasksMax=256
IOWeight=50
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
