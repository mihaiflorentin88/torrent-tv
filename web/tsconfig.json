{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": true
  },
  "include": [
    "src.tsx",
    "settings.tsx",
    "portal.tsx",
    "projects.tsx",
    "shortcuts.ts",
    "*.test.ts",
    "*.test.tsx",
    "osd.tsx",
    "assets.d.ts",
    "../clients/shared/src"
  ]
}
